<?xml version="1.0" encoding="utf-8"?>
<!--
    AyaBelQuran "Verse of the Day" watch face.

    Warm charcoal background, cream retro numerals (Righteous), the day's verse
    in Amiri Quran, and three 70s-style stripes along the bottom bezel.
    The verse comes from the AyaBelQuran app's complication data source.
    Ambient mode drops to black and keeps only dimmed time, date and verse.
-->
<WatchFace width="450" height="450">
    <Metadata key="CLOCK_TYPE" value="DIGITAL" />
    <Metadata key="PREVIEW_TIME" value="10:42:00" />

    <Scene backgroundColor="#FF000000">

        <!-- Background: soft warm glow behind the time -->
        <PartDraw x="0" y="0" width="450" height="450">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Rectangle x="0" y="0" width="450" height="450">
                <Fill color="#FF14110E">
                    <RadialGradient centerX="225" centerY="189" radius="300"
                        colors="#FF221C16 #FF14110E" positions="0 1" />
                </Fill>
            </Rectangle>
        </PartDraw>

        <!-- Retro stripes: burnt orange, mustard, teal -->
        <PartDraw x="0" y="0" width="450" height="450">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Arc centerX="225" centerY="225" width="428" height="428" startAngle="128" endAngle="232">
                <Stroke color="#FFE2592B" thickness="7" cap="ROUND" />
            </Arc>
            <Arc centerX="225" centerY="225" width="406" height="406" startAngle="134" endAngle="226">
                <Stroke color="#FFEEA73A" thickness="7" cap="ROUND" />
            </Arc>
            <Arc centerX="225" centerY="225" width="384" height="384" startAngle="140" endAngle="220">
                <Stroke color="#FF3D8B83" thickness="7" cap="ROUND" />
            </Arc>
        </PartDraw>

        <!-- Date -->
        <PartText x="0" y="72" width="450" height="26">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Text align="CENTER">
                <Font family="righteous" size="18" color="#FFEEA73A">
                    <Upper>
                        <Template>%s %s %s
                            <Parameter expression="[DAY_OF_WEEK_S]" />
                            <Parameter expression="[DAY]" />
                            <Parameter expression="[MONTH_S]" />
                        </Template>
                    </Upper>
                </Font>
            </Text>
        </PartText>
        <PartText x="0" y="72" width="450" height="26" alpha="0">
            <Variant mode="AMBIENT" target="alpha" value="255" />
            <Text align="CENTER">
                <Font family="righteous" size="18" color="#FF9A907E">
                    <Upper>
                        <Template>%s %s %s
                            <Parameter expression="[DAY_OF_WEEK_S]" />
                            <Parameter expression="[DAY]" />
                            <Parameter expression="[MONTH_S]" />
                        </Template>
                    </Upper>
                </Font>
            </Text>
        </PartText>

        <!-- Time -->
        <DigitalClock x="0" y="88" width="450" height="116">
            <TimeText format="hh:mm" hourFormat="SYNC_TO_DEVICE" align="CENTER"
                x="0" y="0" width="450" height="116" alpha="255">
                <Variant mode="AMBIENT" target="alpha" value="0" />
                <Font family="righteous" size="104" color="#FFF2E6CC" />
            </TimeText>
            <TimeText format="hh:mm" hourFormat="SYNC_TO_DEVICE" align="CENTER"
                x="0" y="0" width="450" height="116" alpha="0">
                <Variant mode="AMBIENT" target="alpha" value="255" />
                <Font family="righteous" size="104" color="#FFC9BFAA" />
            </TimeText>
        </DigitalClock>

        <!-- Divider with an eight-point star -->
        <PartDraw x="0" y="0" width="450" height="450">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Line startX="135" startY="212" endX="207" endY="212">
                <Stroke color="#8CEEA73A" thickness="1.5" />
            </Line>
            <Line startX="243" startY="212" endX="315" endY="212">
                <Stroke color="#8CEEA73A" thickness="1.5" />
            </Line>
        </PartDraw>
        <PartDraw x="220" y="207" width="10" height="10">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Rectangle x="0" y="0" width="10" height="10">
                <Fill color="#FFEEA73A" />
            </Rectangle>
        </PartDraw>
        <PartDraw x="220" y="207" width="10" height="10" angle="45">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <Rectangle x="0" y="0" width="10" height="10">
                <Fill color="#FFEEA73A" />
            </Rectangle>
        </PartDraw>

        <!-- Verse of the Day: text = Arabic verse, title = "SURAH · s:a" -->
        <ComplicationSlot slotId="0" displayName="@string/verse_slot_name"
            x="45" y="222" width="360" height="146"
            supportedTypes="LONG_TEXT SHORT_TEXT EMPTY" isCustomizable="TRUE">
            <DefaultProviderPolicy
                primaryProvider="com.raibbl.ayabelquran/com.raibbl.ayabelquran.complication.VerseComplicationService"
                primaryProviderType="LONG_TEXT"
                defaultSystemProvider="EMPTY"
                defaultSystemProviderType="EMPTY" />
            <BoundingBox x="0" y="0" width="360" height="146" />

            <Complication type="LONG_TEXT">
                <PartText x="10" y="4" width="340" height="108">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Text align="CENTER" maxLines="3" ellipsis="TRUE">
                        <Font family="amiri_quran" size="28" color="#FFF2E6CC">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
                <PartText x="10" y="4" width="340" height="108" alpha="0">
                    <Variant mode="AMBIENT" target="alpha" value="255" />
                    <Text align="CENTER" maxLines="3" ellipsis="TRUE">
                        <Font family="amiri_quran" size="28" color="#FF9A907E">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
                <PartText x="0" y="116" width="360" height="24">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="righteous" size="15" color="#FF3D8B83">
                            <Template>%s<Parameter expression="[COMPLICATION.TITLE]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>

            <!-- Any other short-text source the wearer picks -->
            <Complication type="SHORT_TEXT">
                <PartText x="10" y="20" width="340" height="60">
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="righteous" size="40" color="#FFF2E6CC">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
                <PartText x="0" y="116" width="360" height="24">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="righteous" size="15" color="#FF3D8B83">
                            <Template>%s<Parameter expression="[COMPLICATION.TITLE]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>

            <!-- App not installed or slot cleared: a fixed verse so the face is never blank -->
            <Complication type="EMPTY">
                <PartText x="10" y="4" width="340" height="108">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Text align="CENTER" maxLines="3">
                        <Font family="amiri_quran" size="28" color="#FFF2E6CC">إِنَّ مَعَ ٱلْعُسْرِ يُسْرًۭا</Font>
                    </Text>
                </PartText>
                <PartText x="0" y="116" width="360" height="24">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Text align="CENTER">
                        <Font family="righteous" size="15" color="#FF3D8B83">ASH-SHARH · 94:6</Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>
    </Scene>
</WatchFace>
